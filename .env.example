# gpodsync configuration. Copy to .env and edit; .env is never committed.
#
# Every value here is a placeholder. Nothing in this file may name a real host.

# --- Required. The container refuses to start without these. -----------------

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave unset only if you also mount a writable /data, in which case a key is
# generated once and persisted to /data/secret_key with mode 600. Never let this
# change between restarts: a new key invalidates every session, which surfaces in
# AntennaPod as intermittent "wrong username or password".
GPODSYNC_SECRET_KEY=replace-me
# Or read it from a file instead, for docker secrets:
# GPODSYNC_SECRET_KEY_FILE=/run/secrets/gpodsync_secret_key

# Comma-separated. The hostnames this server answers to.
GPODSYNC_ALLOWED_HOSTS=gpodder.example.com

# --- Deployment shape --------------------------------------------------------

# Set to true only when a reverse proxy you control terminates TLS in front of
# this container. It makes the app trust X-Forwarded-* headers, which is how the
# brute-force lockout sees real client addresses instead of the proxy's. Leaving
# it true with no proxy in front lets anyone forge their own IP and walk past the
# lockout, so it defaults to false.
GPODSYNC_BEHIND_PROXY=false

# Whether the session cookie is marked Secure. Keep it true for anything reachable
# from the internet.
#
# Set it to false ONLY when serving over plain HTTP on a trusted LAN. AntennaPod's
# Java cookie jar will not send a Secure cookie back over http, so with true on an
# http deployment login returns 200 and every later request returns 401 — which
# looks like broken credentials and is not.
GPODSYNC_SESSION_COOKIE_SECURE=true

# --- Optional ----------------------------------------------------------------

# Full HTTP request and response tracing, for diagnosing a client that disagrees
# with the server. Deliberately independent of debug mode so it can be switched on
# in production without exposing tracebacks.
#
# The traces contain the complete listening history and every subscription URL.
# Turn it off once you have what you needed.
GPODSYNC_TRACE_REQUESTS=false

# How much of each body to keep. Enough for a full batch of thirty episode
# actions, and short enough that a request full of junk cannot fill a disk one
# log line at a time.
GPODSYNC_TRACE_BODY_LIMIT=8192

GPODSYNC_LOG_LEVEL=INFO

# Never enable on a host reachable from the internet without restricting it by IP
# at your proxy. Account management does not need it: use the adduser command.
GPODSYNC_ENABLE_ADMIN=false

# Creates this account on first start if it does not exist. Omit both to create
# accounts yourself with: docker compose exec gpodsync python manage.py adduser
GPODSYNC_BOOTSTRAP_USER=
GPODSYNC_BOOTSTRAP_PASSWORD=
# GPODSYNC_BOOTSTRAP_PASSWORD_FILE=/run/secrets/gpodsync_bootstrap_password

TZ=UTC
